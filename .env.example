# APOD setup. Run npm run setup to generate only the local database/operator secrets.
# Live provider keys/accounts stay empty until supplied by the operator.
NODE_ENV=development
SERVICE_MODE=setup
DATA_MODE=real
HOST=127.0.0.1
PORT=4720
PUBLIC_BASE_URL=
LOG_LEVEL=info

# Own PostgreSQL / Redis resources; never use another bot's database.
POSTGRES_PASSWORD=
DATABASE_URL=
REDIS_URL=redis://127.0.0.1:56379
QUEUE_PREFIX=apod
STORAGE_DIR=./storage
MAX_DOCUMENT_BYTES=15000000
OPERATOR_TOKEN=
WORKERS_ENABLED=true
OUTBOUND_ENABLED=false
DEMO_DATA_ENABLED=false
DEMO_WHATSAPP_RECIPIENTS=

# WhatsApp Business / Meta. No mailbox or email connection is configured.
WHATSAPP_ENABLED=false
WHATSAPP_TRANSPORT=meta
WA_GRAPH_VERSION=v23.0
WA_API_BASE_URL=
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_TEMPLATE_CONFIG_FILE=

# Optional conversation classifier. Keep `none` until the provider, model and
# reviewed conversation dataset have been approved by the despacho.
# APUD business process version. Independent of the classifier's conversation phase.
APUD_VERSION=1
# Optional local encrypted certificate vault key (32 random bytes as 64 hex characters).
# Keep this deployment secret outside Git. Client certificate passwords never belong here.
APUD_CREDENTIAL_KEY=
CONVERSATION_PHASE=3
# `openai-compatible` activates the Luna-style adapter below. `none` keeps
# local policy only, even when AI_* values happen to be present.
CONVERSATION_AI_PROVIDER=none
CONVERSATION_MODEL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional separately built, anonymized reference agent. It contributes
# reviewed tone/flow metadata only; APOD templates and the FSM remain final.
APOD_AGENT_PACKAGE_DIR=
APOD_MASTER_PROMPT_FILE=docs/source/apud_acta_master_prompt.md
APOD_AGENT_EVAL_REPORT=evidence/agent-evaluations.json

# Optional OpenAI-compatible conversation model. For GPT-5.6 Luna, use the
# endpoint supplied by the approved provider and leave AI_SIN_TEMPERATURE=true.
# The state machine remains the final authority; provider output is a proposal.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=60000
AI_REDACT_PII=true
AI_STREAM=true
AI_SIN_TEMPERATURE=true

# Kmaleon account and OAuth application. The Dayana recipient is required for Kmaleon filing/notices.
KMALEON_ENABLED=false
KMALEON_CONFIG_FILE=./config/kmaleon.json
KMALEON_REJECT_UNAUTHORIZED=true
KMALEON_TIMEOUT_MS=120000
KMALEON_AUTH_TIMEOUT_MS=120000
KMALEON_BASE_URL=
KMALEON_CLIENT_ID=
KMALEON_CLIENT_SECRET=
KMALEON_AUTH_STATE=
KMALEON_REDIRECT_URI=

# Paid provider. The account and payment proof must be supplied/reviewed later.
APUDATA_ENABLED=false
APUDATA_CONFIG_FILE=./config/apudata.json
APUDATA_BASE_URL=
APUDATA_ACCESS_TOKEN=
APUDATA_ACCOUNT_ID=
APUDATA_PAYMENT_IBAN=
APUDATA_PAYMENT_EVIDENCE_REF=
APUDATA_CALLBACK_SECRET=
APUDATA_CALLBACK_PROTOCOL_REVIEWED=false

# Sede draft recipe; client certificates/passwords NEVER belong in this file.
SEDE_ENABLED=false
SEDE_RECIPE_FILE=./config/sede.json

# Reviewed office materials and geography. Empty means pending configuration.
AIRAM_FULL_NAME=
REPRESENTATIVES_FILE=
TUTORIAL_FILE=
CONSENT_VERSION=
CONSENT_TEXT_FILE=
REVOCATION_GUIDE_FILE=
REVOCATION_SCREENSHOTS_FILE=
GEO_CATALOG_FILE=

# Sami's macro 24/27 avisos, saved conversation context, and Dayana review.
# Optional pin: the bot still discovers and verifies the unique active ABAR, SAMI user.
SAMI_USER_ID=
AI_MODE=online
LOCAL_AI_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_AI_MODEL=
LOCAL_AI_API_KEY=
DAYANA_USER_ID=
KMALEON_POLLER_ENABLED=false
KMALEON_POLL_INTERVAL_MS=60000
REMINDERS_ENABLED=true

# Demo chat phone (your own test number). Keep real numbers only in your local .env.
DEMO_PHONE=34600000000
