{
  "name": "apoderamiento-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14 <23"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/main.js",
    "dev": "tsx watch src/main.ts",
    "test": "npm run test:setup",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "verify:infra": "tsx scripts/verify-infra.ts",
    "local:start": "node scripts/start-local.mjs",
    "operator:key": "node scripts/operator-key.mjs",
    "verify:http": "node scripts/verify-http.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "verify:geography": "tsx scripts/verify-geography.ts",
    "setup": "node scripts/setup-env.mjs",
    "setup:check": "tsx scripts/check-setup.ts",
    "demo:seed": "tsx scripts/demo-seed.ts",
    "test:setup": "tsx scripts/test-setup.ts",
    "test:real": "tsx scripts/verify-real.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.0",
    "@fastify/sensible": "^6.0.1",
    "@prisma/client": "6.1.0",
    "bullmq": "^5.34.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "node-forge": "^1.3.3",
    "openai": "^4.77.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "playwright": "^1.49.1",
    "redlock": "^5.0.0-beta.2",
    "undici": "^7.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/node-forge": "^1.3.11",
    "prisma": "6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
